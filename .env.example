# Example placeholders only. Copy to .env for local development.
# Never commit real credentials.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Set a strong, unique local secret; do not use this placeholder as a real secret.
APP_SECRET_KEY=replace-with-a-long-random-development-secret

# Example PostgreSQL connection string. Configure it for your own local database.
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/astronaut_health

# Use synthetic demo data only unless real data is authorized.
DEMO_DATA=true
